{
  "info": {
    "name": "Aula 4 - Integracao ViaCEP",
    "description": "Collection da Atividade M1. Ajuste baseUrl e productId na aba Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Disponibilidade (Aula 4)",
      "item": [
        {
          "name": "CEP de Mogi das Cruzes (true)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=08773380",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "cep",
                  "value": "08773380"
                }
              ]
            },
            "description": "O produto p1 tem centro de distribuicao em Mogi das Cruzes. Resposta esperada: true."
          }
        },
        {
          "name": "CEP de Sao Paulo (false)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=01310930",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "cep",
                  "value": "01310930"
                }
              ]
            },
            "description": "Cidade diferente do centro de distribuicao. Resposta esperada: false."
          }
        },
        {
          "name": "CEP com hifen",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=08773-380",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "cep",
                  "value": "08773-380"
                }
              ]
            },
            "description": "O hifen e removido antes da consulta. Resposta esperada: true."
          }
        },
        {
          "name": "CEP invalido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=123",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "cep",
                  "value": "123"
                }
              ]
            },
            "description": "Menos de 8 digitos. Resposta esperada: 400."
          }
        },
        {
          "name": "CEP inexistente (404)",
          "request": {
            "method": "GET",
