      ]
    },
    {
      "name": "CRUD e consultas (Aulas 1 a 3)",
      "item": [
        {
          "name": "Listar produtos ativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            }
          }
        },
        {
          "name": "Produto por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/endpoint2/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "endpoint2",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Produtos por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/endpoint1?categoryAsParam=electronics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "endpoint1"
              ],
              "query": [
                {
                  "key": "categoryAsParam",
                  "value": "electronics"
                }
              ]
            }
          }
        },
        {
          "name": "Top 5 por preco",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/endpoint3/top5byprice",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "endpoint3",
                "top5byprice"
              ]
            }
          }
        },
        {
          "name": "Criar produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produto de Teste\",\n  \"price\": 12345,\n  \"category\": \"electronics\",\n  \"distributionCenter\": \"Recife\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            }
          }
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\",\n  \"name\": \"Produto Atualizado\",\n  \"price\": 54321,\n  \"category\": \"electronics\",\n  \"distributionCenter\": \"Recife\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/product",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product"
              ]
            }
          }
        },
        {
          "name": "Inativar produto (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/product/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "p1"
    }
  ]
}