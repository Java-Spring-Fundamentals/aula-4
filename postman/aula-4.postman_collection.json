              "raw": "{{baseUrl}}/product/{{productId}}/availability?cep=99999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "product",
                "{{productId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "cep",
                  "value": "99999999"
                }
              ]
            },
            "description": "A ViaCEP nao encontra o CEP. Resposta esperada: 404."
          }
        },
        {
