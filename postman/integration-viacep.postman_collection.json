{
  "info": {
    "name": "Integration ViaCEP - availability",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "productId", "value": "p1"}
  ],
  "item": [
    {
      "name": "Disponível - Mogi das Cruzes",
      "request": {"method": "GET", "url": "{{baseUrl}}/product/availability/{{productId}}?cep=08773380"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Disponível', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql(true); });"]}}]
    },
    {
      "name": "Indisponível - Recife",
      "request": {"method": "GET", "url": "{{baseUrl}}/product/availability/{{productId}}?cep=50010000"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Indisponível', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql(false); });"]}}]
    },
    {
      "name": "CEP inválido",
      "request": {"method": "GET", "url": "{{baseUrl}}/product/availability/{{productId}}?cep=123"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('CEP inválido', () => pm.response.to.have.status(400));"]}}]
    },
    {
      "name": "CEP inexistente",
      "request": {"method": "GET", "url": "{{baseUrl}}/product/availability/{{productId}}?cep=00000000"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('CEP inexistente', () => pm.response.to.have.status(404));"]}}]
    },
    {
      "name": "Produto inexistente",
      "request": {"method": "GET", "url": "{{baseUrl}}/product/availability/nao-existe?cep=08773380"},
      "event": [{"listen": "test", "script": {"exec": ["pm.test('Produto inexistente', () => pm.response.to.have.status(404));"]}}]
    }
  ]
}
